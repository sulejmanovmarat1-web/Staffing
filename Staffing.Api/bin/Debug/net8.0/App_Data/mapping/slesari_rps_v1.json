      "metric_key": "staffing_to_staff_list_total_pct",
      "unit": "percent",
      "date_binding": "report_date"
    },
    {
      "header_path": "штатн.*численность\\s*с\\s*01\\.05\\.2025\\s*/\\s*Оперативная ФПКОП$",
      "metric_key": "staffing_01052025_oper_need",
      "unit": "count",
      "date_binding": "report_date"
    },
    {
      "header_path": "штатн.*численность\\s*с\\s*01\\.05\\.2025\\s*/\\s*Ук\\.\\%$",
      "metric_key": "staffing_01052025_oper_pct",
      "unit": "percent",
      "date_binding": "report_date",
      "col": 22
    },
    {
      "header_path": "штатн.*численность\\s*с\\s*01\\.05\\.2025\\s*/\\s*штат$",
      "metric_key": "staffing_01052025_staff",
      "unit": "count",
      "date_binding": "report_date"
    },
    {
      "header_path": "штатн.*численность\\s*с\\s*01\\.05\\.2025\\s*/\\s*в т\\.ч\\.\\s*временно на лето$",
      "metric_key": "staffing_01052025_summer_temp",
      "unit": "count",
      "date_binding": "report_date"
    },
    {
      "header_path": "штатн.*численность\\s*с\\s*01\\.05\\.2025\\s*/\\s*Ук\\.\\%$",
      "metric_key": "staffing_01052025_staff_pct",
      "unit": "percent",
      "date_binding": "report_date",
      "col": 25
    },
    {
      "header_path": "Штатное расписание с врем\\..*",
      "metric_key": "staff_list_with_temp",
      "unit": "count",
      "date_binding": "report_date"
    },
    {
      "header_path": "%\\s*укомпл\\..*к штатному расписанию с врем\\..*",
      "metric_key": "staffing_to_staff_list_with_temp_pct",
      "unit": "percent",
      "date_binding": "report_date"
    },
    {
      "header_path": "Планируемый прием к\\s*30\\s*сентября\\s*/\\s*вольный найм$",
      "metric_key": "hire_plan_sep30_free_hire",
      "unit": "count",
      "date_binding": "report_date"
    },
    {
      "header_path": "Планируемый прием к\\s*30\\s*сентября$",
      "metric_key": "hire_plan_sep30_total",
      "unit": "count",
      "date_binding": "report_date"
    },
    {
      "header_path": "Планируемый прием к\\s*30\\s*сентября\\s*/\\s*студенты на практику$",
      "metric_key": "hire_plan_sep30_students_practice",
      "unit": "count",
      "date_binding": "report_date"
    },
    {
      "header_path": "Планируемый прием к\\s*30\\s*сентября\\s*/\\s*группы подготовки$",
      "metric_key": "hire_plan_sep30_training_groups",
      "unit": "count",
      "date_binding": "report_date"
    },
    {
      "header_path": "ожидаемый отток к\\s*30\\s*сентября$",
      "metric_key": "expected_outflow_sep30",
      "unit": "count",
      "date_binding": "report_date"
    },
    {
      "header_path": "Ожидаемое восполнение к\\s*30\\s*сентября$",
      "metric_key": "expected_replenishment_sep30",
      "unit": "count",
      "date_binding": "report_date"
    },
    {
      "header_path": "%\\s*укомлектованности к\\s*30\\s*сентября$",
      "metric_key": "staffing_pct_sep30",
      "unit": "percent",
      "date_binding": "report_date",
      "col": 36
    }
  ]
}