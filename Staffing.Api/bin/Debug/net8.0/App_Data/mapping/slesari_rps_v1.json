{
  "template_version": "v1",
  "header_normalization": {
    "trim": true,
    "collapse_spaces": true,
    "normalize_newlines": true
  },
  "date_rules": {
    "extract_ddmmyyyy": "(\\d{2}\\.\\d{2}\\.\\d{4})"
  },
  "report_template_key": "slesari_rps",
  "mappings": [
    {
      "header_path": "Филиалы/\\s*СП\\s*филиалов",
      "metric_key": "__division_name__",
      "unit": "text",
      "date_binding": "none"
    },
    {
      "header_path": "Потребность ноября\\s*/\\s*ФПКШ$",
      "metric_key": "need_nov_fpks_count",
      "unit": "count",
      "date_binding": "report_date"
    },
    {
      "header_path": "Потребность ноября\\s*/\\s*ФПКШ\\s*\\(привед\\)$",
      "metric_key": "need_nov_fpks_norm_count",
      "unit": "count",
      "date_binding": "report_date"
    },
    {
      "header_path": "Потребность ноября\\s*/\\s*ФПКОП$",
      "metric_key": "need_nov_fpkop_count",
      "unit": "count",
      "date_binding": "report_date"
    },
    {
      "header_path": "Потребность ноября\\s*/\\s*ФПКОП\\s*\\(привед\\)$",
      "metric_key": "need_nov_fpkop_norm_count",
      "unit": "count",
      "date_binding": "report_date"
    },
    {
      "header_path": "Потребность ноября\\s*/\\s*Фактически сложившаяся потребность$",
      "metric_key": "need_nov_actual_need_count",
      "unit": "count",
      "date_binding": "report_date"
    },
    {
      "header_path": "Потребность ноября\\s*/\\s*Фактическая численность на .*",
      "metric_key": "need_nov_actual_headcount",
      "unit": "count",
      "date_binding": "report_date"
    },
    {
      "header_path": "Потребность ноября\\s*/\\s*Укомп\\..*потреб\\.,%$",
      "metric_key": "need_nov_staffing_pct",
      "unit": "percent",
      "date_binding": "report_date"
    },
    {
      "header_path": "Списочная численность на .*",
      "metric_key": "headcount_list",
      "unit": "count",
      "date_binding": "date_from_header"
    },
    {
      "header_path": "Технологическая потребность августа 2024\\s*/\\s*Плановая ФПКШ$",
      "metric_key": "tech_need_plan_fpks",
      "unit": "count",
      "date_binding": "report_date"
    },
    {
      "header_path": "Технологическая потребность августа 2024\\s*/\\s*Оперативная ФПКОП$",
      "metric_key": "tech_need_oper_fpkop",
      "unit": "count",
      "date_binding": "report_date"
    },
    {
      "header_path": "Технологическая потребность августа 2024\\s*/\\s*Оперативная\\s*\\(приведенная\\)\\s*ФПКОП$",
      "metric_key": "tech_need_oper_fpkop_norm",
      "unit": "count",
      "date_binding": "report_date"
    },
    {
      "header_path": "Технологическая потребность августа 2024\\s*/\\s*Ук\\.\\%$",
      "metric_key": "tech_need_aug_plan_staffing_pct",
      "unit": "percent",
      "date_binding": "report_date",
      "col": 12
    },
    {
      "header_path": "Технологическая потребность августа 2024\\s*/\\s*Ук\\.\\%$",
      "metric_key": "tech_need_aug_oper_staffing_pct",
      "unit": "percent",
      "date_binding": "report_date",
      "col": 14
    },
    {
      "header_path": "Технологическая потребность августа 2024\\s*/\\s*Ук\\.\\%$",
      "metric_key": "tech_need_aug_oper_norm_staffing_pct",
      "unit": "percent",
      "date_binding": "report_date",
      "col": 16
    },
    {
      "header_path": "дефицит ВСЕГО к оперативной потребности$",
      "metric_key": "deficit_to_oper_need",
      "unit": "count",
      "date_binding": "report_date"
    },
    {
      "header_path": "Новое задание по содержанию постоянного контингента.*",
      "metric_key": "task_perm_contingent",
      "unit": "count",
      "date_binding": "report_date"
    },
